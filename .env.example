# Network: "mainnet" (default) or "testnet"
# Testnet uses DFK Chain testnet (ID 335) — get test JEWEL at https://faucet.avax.network/?subnet=dfk
# VITE_NETWORK=testnet

# Optional: Override the default DFK Chain RPC endpoint
# VITE_DFK_RPC_URL=https://subnets.avax.network/defi-kingdoms/dfk-chain/rpc

# Optional: Override the default donation address (defaults to project maintainer)
# VITE_DONATION_ADDRESS=0x...

# Optional: WalletConnect project ID (get one free at cloud.reown.com)
# VITE_WALLETCONNECT_PROJECT_ID=
